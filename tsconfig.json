{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "outDir": "./dist/packages/win-unpacked/scripts",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "declaration": true,
        "sourceMap": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@electron/*": ["./src/electron/*"],
            "@renderer/*": ["./src/renderer/*"],
            "@shared/*": ["./src/shared/*"],
            "@utils/*": ["./src/utils/*"],
            "@config/*": ["./src/config/*"]
        },
        "types": ["node", "electron"]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "**/*.spec.ts",
        "build.config.ts",
        "vitest.config.ts",
        "tests/**/*"
    ]
}